{
  "uid": "flowpay-identity",
  "title": "FlowPay / Identity (Auth + Account)",
  "tags": ["flowpay"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "## Auth Service" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Login Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(rate(auth_default_login_account_requests_total{outcome!=\"success\"}[5m])) / sum(rate(auth_default_login_account_requests_total[5m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Registration Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(rate(auth_creation_requests_total{outcome!=\"success\"}[5m])) / sum(rate(auth_creation_requests_total[5m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Login p95 Latency",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(auth_default_login_account_request_duration_seconds_bucket[5m])))", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Refresh Rate",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(rate(auth_refresh_requests_total[5m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Login/Register/Refresh/Logout Rate by Outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(auth_default_login_account_requests_total[5m]))", "legendFormat": "login - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum by (outcome) (rate(auth_creation_requests_total[5m]))", "legendFormat": "register - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "sum by (outcome) (rate(auth_refresh_requests_total[5m]))", "legendFormat": "refresh - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "D", "expr": "sum by (outcome) (rate(auth_logout_requests_total[5m]))", "legendFormat": "logout - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Default/Demo Login Rate by Outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(auth_default_login_account_requests_total[5m]))", "legendFormat": "default login - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum by (outcome, account_type) (rate(auth_default_login_account_requests_total[5m]))", "legendFormat": "demo account ({{account_type}}) - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "sum by (outcome, account_type) (rate(auth_default_login_user_requests_total[5m]))", "legendFormat": "demo user ({{account_type}}) - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 8,
      "type": "text",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 14 },
      "options": { "mode": "markdown", "content": "## Account Service" }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Account/Company/User Creation Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(account_create_requests_total[5m]))", "legendFormat": "account - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum by (outcome) (rate(company_create_requests_total[5m]))", "legendFormat": "company - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "sum by (outcome) (rate(user_create_requests_total[5m]))", "legendFormat": "user - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Read Endpoint Latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(balance_get_request_duration_seconds_bucket[5m])))", "legendFormat": "balance", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(transactions_list_request_duration_seconds_bucket[5m])))", "legendFormat": "transactions list", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(accounts_list_request_duration_seconds_bucket[5m])))", "legendFormat": "accounts list", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "D", "expr": "histogram_quantile(0.95, sum by (le) (rate(default_list_get_request_duration_seconds_bucket[5m])))", "legendFormat": "default list", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
}
